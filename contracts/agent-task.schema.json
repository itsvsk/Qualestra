{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelqa.example.test/contracts/agent-task.schema.json",
  "title": "AgentTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "run_id", "agent_type", "agent_version", "status", "dependency_task_ids", "input_ref", "idempotency_key", "target_partition", "budget", "deadline", "attempt"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "parent_task_id": {"type": ["string", "null"], "format": "uuid"},
    "agent_type": {"enum": ["change_impact", "ui_explorer", "api_explorer", "data_invariant", "verification", "defect_triage"]},
    "agent_version": {"type": "string"},
    "status": {"enum": ["pending", "ready", "leased", "running", "succeeded", "failed", "timed_out", "cancelled", "superseded"]},
    "dependency_task_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "input_ref": {"type": "string", "pattern": "^blackboard://"},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "target_partition": {"type": "string", "minLength": 1},
    "budget": {"$ref": "#/$defs/budget"},
    "deadline": {"type": "string", "format": "date-time"},
    "attempt": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_seconds", "max_tool_calls", "max_model_tokens", "max_api_requests", "max_artifact_bytes"],
      "properties": {
        "max_seconds": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "max_model_tokens": {"type": "integer", "minimum": 0},
        "max_api_requests": {"type": "integer", "minimum": 0},
        "max_artifact_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}

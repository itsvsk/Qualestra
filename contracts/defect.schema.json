{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Defect", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "defect_id", "run_id", "title", "severity", "confidence", "status", "affected_area", "signature", "persona", "preconditions", "steps_to_reproduce", "expected", "actual", "verification", "evidence", "suspected_component", "suggested_investigation", "created_at"],
  "properties": {"schema_version": {"const": "1.0"}, "defect_id": {"type": "string", "format": "uuid"}, "run_id": {"type": "string", "format": "uuid"}, "title": {"type": "string", "minLength": 1}, "severity": {"enum": ["low", "medium", "high", "critical"]}, "confidence": {"type": "number", "minimum": 0.7, "maximum": 1}, "status": {"const": "verified"}, "affected_area": {"type": "string"}, "signature": {"type": "string"}, "persona": {"type": "string"}, "preconditions": {"type": "array", "items": {"type": "string"}}, "steps_to_reproduce": {"type": "array", "items": {"type": "object"}}, "expected": {"type": "string"}, "actual": {"type": "string"}, "verification": {"type": "object"}, "evidence": {"type": "array", "items": {"type": "object"}}, "suspected_component": {"type": "string"}, "suggested_investigation": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}}
}

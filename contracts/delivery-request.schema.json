{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelqa.example.test/contracts/delivery-request.schema.json",
  "title": "DeliveryRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delivery_id",
    "run_id",
    "report_id",
    "report_digest",
    "report_format",
    "connector_id",
    "destination_id",
    "mode",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "delivery_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "report_id": {"type": "string", "format": "uuid"},
    "report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "report_format": {"enum": ["json", "markdown", "html"]},
    "connector_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "destination_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "mode": {"enum": ["dry_run", "manual", "automatic"]},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
